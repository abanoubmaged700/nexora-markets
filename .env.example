# NEXORA Markets Environment Variables Template (.env.example)

# Google Gemini API Key (Required for AI Agents)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Secure Shared Secret for n8n Webhooks (HMAC Signature Verification)
N8N_WEBHOOK_SECRET=nexora_secure_shared_secret_2026

# Telegram Bot Token (Optional for live broadcast)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Editorial Group Chat ID
TELEGRAM_EDITORIAL_CHAT_ID=your_chat_id_here
