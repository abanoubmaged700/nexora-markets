{
  "name": "NEXORA - Telegram Connection Test v1",
  "nodes": [
    {
      "id": "manual-test",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "prepare-private-test",
      "name": "Prepare private test",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const chatId = 'REPLACE_WITH_PRIVATE_CHAT_ID';\nif (chatId.startsWith('REPLACE_')) throw new Error('Set the private owner chat ID in this node first');\nreturn [{json:{chat_id:chatId,text:'NEXORA Markets | Telegram connection test. No channel publication. ' + new Date().toISOString()}}];"
      }
    },
    {
      "id": "send-private-test",
      "name": "Send private test",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        500,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    }
  ],
  "connections": {
    "Manual test": {
      "main": [
        [
          {
            "node": "Prepare private test",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare private test": {
      "main": [
        [
          {
            "node": "Send private test",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Africa/Cairo",
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "active": false,
  "pinData": {},
  "tags": []
}
