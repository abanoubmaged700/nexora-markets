{
  "name": "NEXORA - News Engine v1 - approval required",
  "nodes": [
    {
      "id": "official-rss-polling",
      "name": "Official RSS polling",
      "type": "n8n-nodes-base.rssFeedReadTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "feedUrl": "https://www.federalreserve.gov/feeds/press_monetary.xml",
        "pollTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        }
      }
    },
    {
      "id": "validate-official-source",
      "name": "Validate official source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out=[];\nfor (let i=0;i<items.length;i++) {\n  const v=items[i].json;\n  const title=String(v.title||'').trim();\n  const link=String(v.link||'').trim();\n  const stamp=String(v.isoDate||v.pubDate||'');\n  const date=new Date(stamp);\n  let u;\n  try { u=new URL(link); } catch { continue; }\n  if (u.protocol!=='https:' || u.hostname!=='www.federalreserve.gov') continue;\n  if (!title || !Number.isFinite(date.getTime())) continue;\n  const age=Date.now()-date.getTime();\n  if (age < -3600000 || age > 14*86400000) continue;\n  const sourceId=link.split('#')[0].split('?')[0];\n  const cairo=new Intl.DateTimeFormat('ar-EG',{timeZone:'Africa/Cairo',dateStyle:'medium',timeStyle:'short'}).format(date);\n  out.push({json:{source_id:sourceId,title,source_url:link,event_utc:date.toISOString(),source_utc:date.toISOString(),source_cairo:cairo,verification_status:'official_rss_metadata',source_name:'Federal Reserve Board',summary:String(v.contentSnippet||v.content||'').replace(/<[^>]*>/g,' ').slice(0,1000)},pairedItem:{item:i}});\n}\nreturn out;"
      }
    },
    {
      "id": "check-source-id",
      "name": "Check source ID",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        510,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "NEXORA_News_Log"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "source_id",
              "condition": "eq",
              "keyValue": "={{ $json.source_id }}"
            }
          ]
        },
        "limit": 1
      },
      "alwaysOutputData": true
    },
    {
      "id": "keep-unseen-items",
      "name": "Keep unseen items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out=[];\nfor (let i=0;i<items.length;i++) {\n  if (items[i].json.id) continue;\n  const source=$('Validate official source').itemMatching(i).json;\n  out.push({json:source,pairedItem:{item:i}});\n}\nreturn out;"
      }
    },
    {
      "id": "draft-with-gemini",
      "name": "Draft with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({contents:[{parts:[{text:'Write a short Arabic financial news draft using only this official source title and summary. Do not invent numbers, prices, effects, or trading recommendations. Clearly state uncertainty. Title: ' + $json.title + '\\nSummary: ' + $json.summary + '\\nSource UTC: ' + $json.source_utc}]}],generationConfig:{temperature:0.2,maxOutputTokens:350}}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "compose-attributed-draft",
      "name": "Compose attributed draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out=[];\nfor (let i=0;i<items.length;i++) {\n  const source=$('Keep unseen items').itemMatching(i).json;\n  const generated=items[i].json.candidates?.[0]?.content?.parts?.map(p=>p.text||'').join(' ').trim()||'';\n  if (!generated || generated.length>1600) throw new Error('Gemini returned an empty or oversized draft');\n  const draft='NEXORA Markets 🔱\\n\\n'+generated+'\\n\\nالمصدر: '+source.source_name+'\\n'+source.source_url+'\\nوقت المصدر (القاهرة): '+source.source_cairo+'\\n\\nمحتوى إخباري تعليمي، وليس نصيحة استثمارية.';\n  const usage=items[i].json.usageMetadata||{};\n  out.push({json:{...source,draft,status:'pending',created_utc:new Date().toISOString(),gemini_input_tokens:String(usage.promptTokenCount??''),gemini_output_tokens:String(usage.candidatesTokenCount??''),gemini_model:'gemini-3.8-flash'},pairedItem:{item:i}});\n}\nreturn out;"
      }
    },
