    {
      "id": "normalize-failure",
      "name": "Normalize failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        250,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=items[0]?.json||{};\nconst now=new Date().toISOString();\nreturn [{json:{source_id:'error:'+String(e.execution?.id||now),title:String(e.workflow?.name||'NEXORA News Engine')+' / '+String(e.execution?.lastNodeExecuted||'unknown'),source_url:'',source_utc:now,source_cairo:new Intl.DateTimeFormat('ar-EG',{timeZone:'Africa/Cairo',dateStyle:'medium',timeStyle:'short'}).format(new Date()),draft:String(e.execution?.error?.message||e.trigger?.error?.message||'Unknown error').slice(0,1200),status:'error',created_utc:now,telegram_message_id:''}}];"
      }
    },
    {
      "id": "record-error",
      "name": "Record error",
